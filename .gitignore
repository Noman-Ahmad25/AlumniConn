.vite/

# --- Environment Secrets (CRITICAL) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- IDEs and OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Ignore all Markdown files
*.md

# Ignore anything in a 'docs' or 'migrations' folder
docs




# Ignore all files in the static folder and its subfolders
server/static/**/*

# Except for .gitkeep files so the folders stay in Git
!server/static/**/.gitkeep