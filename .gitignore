blob-report/

# --- JavaScript/TypeScript (Vite + React) ---
node_modules/
dist/
dist-ssr/
*.local
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/           # Frontend coverage reports
.vitest-cache/      # Vitest's internal speed-up cache
playwright-report/  # If you end up using Playwright for E2E tests
